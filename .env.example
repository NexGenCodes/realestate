# --- Django Settings ---
SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# --- Database (PostGIS) ---
DB_NAME=realestate_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# --- Redis & Caching ---
REDIS_URL=redis://redis:6379/1
CACHE_TTL=3600

# --- Flutterwave (Payments) ---
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxx
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxx
FLW_ENCRYPTION_KEY=xxxxxxxxxxxxxxxx
FLW_SECRET_HASH=realestate_webhook_secret

# --- Firebase (Notifications) ---
# Path to serviceAccountKey.json relative to app root
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json

# --- Cloudinary (Media) ---
CLOUDINARY_CLOUD_NAME=dxxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxx

# --- Email (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# --- Sentry (Monitoring) ---
SENTRY_DSN=https://xxxxxxxx@o0.ingest.sentry.io/0

